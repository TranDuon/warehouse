<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.warehouse_desktop.controller.HomeController">

    <top>
        <HBox spacing="20" style="-fx-background-color: #ffffff; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 10, 0, 0, 2);">
            <padding>
                <Insets bottom="12" left="20" right="20" top="12" />
            </padding>

            <ImageView fitHeight="45" fitWidth="45" preserveRatio="true">
                <image>
                    <Image url="@/images/Logo_noName.png" />
                </image>
            </ImageView>

            <Label style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Warehouse Management" />

            <Pane HBox.hgrow="ALWAYS" />

            <Button fx:id="userButton" style="-fx-background-color: #7aa872; -fx-text-fill: white; -fx-background-radius: 6;" text="User" />
        </HBox>
    </top>

    <left>
        <VBox prefWidth="220" spacing="15" style="-fx-background-color: #7aa872; -fx-padding: 20;">

            <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;" text="Danh mục" />

            <Button fx:id="btnProduct" onAction="#openProductPage" prefWidth="180" style="-fx-background-radius: 6; -fx-background-color: #ffffff; -fx-text-fill: #2d2d2d;" text="Quản lý vật phẩm" />

            <Button fx:id="btnPurchase" onAction="#openPurchasePage" prefWidth="180" style="-fx-background-radius: 6; -fx-background-color: #ffffff; -fx-text-fill: #2d2d2d;" text="Nhập hàng" />

            <Button fx:id="btnSell" onAction="#openSellPage" prefWidth="180" style="-fx-background-radius: 6; -fx-background-color: #ffffff; -fx-text-fill: #2d2d2d;" text="Bán hàng" />

            <Pane VBox.vgrow="ALWAYS" />
<!--         <Button fx:id="btnBack" onAction="#openHomePage" prefWidth="180" style="-fx-background-radius: 6; -fx-background-color: #a5a5a5; -fx-text-fill: #ffffff;" text="&lt;&lt; Trở về Trang chủ" />-->
        </VBox>
    </left>

    <center>
        <ScrollPane fx:id="mainScroll" fitToHeight="true" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;">

            <VBox fx:id="mainContent" spacing="20" style="-fx-background-color: #dbe4d8;">
                <padding>
                    <Insets bottom="25" left="40" right="40" top="25" />
                </padding>

                <Label style="-fx-font-size: 22px; -fx-font-weight: bold;" text="Chào mừng bạn đến hệ thống quản lý kho!" />

                <Label style="-fx-font-size: 14px;" text="Bạn có thể chọn một chức năng ở menu bên trái để bắt đầu." />

                <TilePane hgap="20" prefColumns="2" vgap="20">

                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="📦 Quản lý vật phẩm" />
                        <Label text="Thêm, xóa, chỉnh sửa danh sách sản phẩm của kho." wrapText="true" />
                        <Button onAction="#openProductPage" style="-fx-background-color: #7aa872; -fx-text-fill: white; -fx-background-radius: 6;" text="Open" />
                    </VBox>

                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="⬆ Nhập hàng" />
                        <Label text="Quản lí sản phẩm vào kho, cập nhật số lượng." wrapText="true" />
                        <Button onAction="#openPurchasePage" style="-fx-background-color: #7aa872; -fx-text-fill: white; -fx-background-radius: 6;" text="Open" />
                    </VBox>

                    <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-background-radius: 10; -fx-padding: 20;">
                        <Label style="-fx-font-size: 16px; -fx-font-weight: bold;" text="⬇ Bán hàng" />
                        <Label text="Quản lí sản phẩm xuất kho, cập nhật số lượng." wrapText="true" />
                        <Button onAction="#openSellPage" style="-fx-background-color: #7aa872; -fx-text-fill: white; -fx-background-radius: 6;" text="Open" />
                    </VBox>

                </TilePane>
            </VBox>
        </ScrollPane>
    </center>

</BorderPane>
