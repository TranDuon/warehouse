<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.ColumnConstraints?>
<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.warehouse_desktop.controller.product.ProductHomeController"
            style="-fx-background-color: white;"
            prefHeight="800" prefWidth="900">

    <center>
        <VBox alignment="TOP_CENTER" spacing="25" maxWidth="Infinity">
            <padding>
                <Insets top="30" bottom="30" left="40" right="40"/>
            </padding>

            <Label text="Quản lý vật phẩm"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E3D59;"/>

            <Label text="Chọn chức năng để bắt đầu thao tác với vật phẩm"
                   style="-fx-font-size: 16px; -fx-text-fill: #4B4B4B;"/>

            <GridPane hgap="35" vgap="20" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                    <ColumnConstraints percentWidth="33"/>
                </columnConstraints>

                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: #4CAF50; -fx-background-radius: 12;"
                      minWidth="0" maxWidth="Infinity"
                      GridPane.hgrow="ALWAYS">

                    <padding>
                        <Insets top="15" bottom="15" left="15" right="15" />
                    </padding>

                    <Label text="➕ Tạo vật phẩm mới"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;" />

                    <Label wrapText="true"
                           text="Thêm một vật phẩm mới vào hệ thống."
                           style="-fx-font-size: 13px; -fx-text-fill: white;" />

                    <Button fx:id="btnCreate" text="Mở"
                            prefHeight="35" prefWidth="120"
                            style="-fx-background-color: white; -fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>

                </VBox>


                <VBox alignment="CENTER" spacing="15"
                      prefHeight="170"
                      GridPane.columnIndex="1"
                      style="-fx-background-color: #2196F3; -fx-background-radius: 12;">
                    <padding><Insets top="18" bottom="18" left="18" right="18"/></padding>
                    <Label text="📋 Danh sách"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Xem toàn bộ danh sách vật phẩm có trong kho."
                           wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                    <Button fx:id="btnGetList" text="Mở"
                            prefWidth="120" prefHeight="35"
                            style="-fx-background-color: white; -fx-text-fill: #2196F3; -fx-font-weight: bold; -fx-background-radius: 6;"/>
                    <effect><DropShadow radius="5" color="#888"/></effect>
                </VBox>

                <VBox alignment="CENTER" spacing="15"
                      prefHeight="170"
                      GridPane.columnIndex="2"
                      style="-fx-background-color: #FF9800; -fx-background-radius: 12;">
                    <padding><Insets top="18" bottom="18" left="18" right="18"/></padding>
                    <Label text="🔍 Tìm vật phẩm"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                    <Label text="Tìm kiếm vật phẩm theo tên."
                           wrapText="true" style="-fx-font-size: 13px; -fx-text-fill: white;"/>
                    <Button fx:id="btnSearchByName" text="Mở"
                            prefWidth="120" prefHeight="35"
                            style="-fx-background-color: white; -fx-text-fill: #FF9800; -fx-font-weight: bold; -fx-background-radius: 6;"/>
                    <effect><DropShadow radius="5" color="#888"/></effect>
                </VBox>

            </GridPane>

        </VBox>
    </center>

</BorderPane>
