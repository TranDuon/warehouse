<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>

<BorderPane prefWidth="800" prefHeight="550"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@../css/style.css"
            fx:controller="com.mycompany.mavenproject3.Controller.CreatePurchaseController">

    <!-- TOP TITLE -->
    <top>
        <Label text="Tạo lượt nhập hàng"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER">
            <font>
                <Font size="18"/>
            </font>
        </Label>
    </top>

    <!-- MAIN BODY -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <!-- TABLE -->
            <TableView fx:id="table" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colStt" text="STT" prefWidth="50"/>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colTen" text="Tên" prefWidth="150"/>
                    <TableColumn fx:id="colGia" text="Giá" prefWidth="100"/>
                    <TableColumn fx:id="colDonVi" text="Đơn vị" prefWidth="80"/>
                    <TableColumn fx:id="colConKho" text="Còn kho" prefWidth="100"/>
                    <TableColumn fx:id="colSoLuongNhap" text="Số lượng nhập" prefWidth="120"/>
                </columns>
            </TableView>

            <!-- BUTTONS: add/remove -->
            <HBox spacing="10">
                <Button fx:id="btnAddProduct" text="Thêm sản phẩm"/>
                <Button fx:id="btnRemoveProduct" text="Xoá sản phẩm"/>
            </HBox>

            <Separator/>

            <!-- BUTTONS: bottom -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnCreate" text="Tạo lượt nhập hàng"/>
                <Button fx:id="btnCancel" text="Huỷ"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
