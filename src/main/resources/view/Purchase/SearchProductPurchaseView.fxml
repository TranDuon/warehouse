<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="650" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.warehouse_desktop.controller.purchase.SearchProductPurchaseController">

    <top>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Tìm kiếm và thêm vật phẩm" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- Ô tìm kiếm -->
            <HBox spacing="10">
                <Label text="Nhập tên sản phẩm:" />
                <TextField fx:id="nameKeyword" prefWidth="200" />
                <Button fx:id="btnSearch" text="Search" />
            </HBox>

            <!-- Bảng -->
            <Label style="-fx-font-weight: bold;" text="Kết quả tìm kiếm:" />

            <TableView fx:id="table" prefHeight="320" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" text="ID" />
                    <TableColumn fx:id="colTen" prefWidth="136.8000030517578" text="Tên" />
                    <TableColumn fx:id="colGia" prefWidth="69.5999755859375" text="Giá" />
                    <TableColumn fx:id="colDonVi" prefWidth="76.79998779296875" text="Đơn vị" />
                    <TableColumn fx:id="colMoTa" prefWidth="156.79986572265625" text="Mô tả" />
                    <TableColumn fx:id="colSoLuong" prefWidth="111.20001220703125" text="Số lượng" />
                </columns>
            </TableView>

            <Button fx:id="btnAdd" prefWidth="120" text="Add" />
        </VBox>
    </center>

</BorderPane>
