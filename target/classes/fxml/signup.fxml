<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="500.0" prefWidth="750.0"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.warehouse_desktop.controller.SignupController">

    <top>
        <AnchorPane prefHeight="503.0" prefWidth="750.0">
            <children>

                <!-- Logo -->
                <VBox alignment="TOP_CENTER" layoutX="280.0"
                      AnchorPane.leftAnchor="280.0"
                      AnchorPane.rightAnchor="270.4">
                    <children>
                        <ImageView fitHeight="120.0" preserveRatio="true">
                            <image>
                                <Image url="@../images/logo-icon.png" />
                            </image>
                        </ImageView>
                    </children>
                </VBox>

                <!-- Username -->
                <TextField fx:id="username"
                           layoutX="194.0" layoutY="134.0"
                           prefHeight="26.0" prefWidth="358.0"
                           promptText="Username">
                    <font><Font size="16.0" /></font>
                </TextField>

                <!-- Password -->
                <PasswordField fx:id="password"
                               layoutX="196.0" layoutY="183.0"
                               prefHeight="26.0" prefWidth="358.0"
                               promptText="Password">
                    <font><Font size="16.0" /></font>
                </PasswordField>

                <!-- Email -->
                <TextField fx:id="email"
                           layoutX="196.0" layoutY="231.0"
                           prefHeight="26.0" prefWidth="358.0"
                           promptText="Email">
                    <font><Font size="16.0" /></font>
                </TextField>

                <!-- Phone -->
                <TextField fx:id="email1"
                           layoutX="196.0" layoutY="281.0"
                           prefHeight="26.0" prefWidth="358.0"
                           promptText="Phone number">
                    <font><Font size="16.0" /></font>
                </TextField>

                <!-- Notification label -->
                <Label fx:id="noti"
                       layoutX="196.0" layoutY="312.0"
                       textFill="red" visible="false"
                       text="Please fill all fields!" />

                <!-- Create Account button -->
                <Button fx:id="create"
                        layoutX="195.0" layoutY="340.0"
                        prefHeight="34.0" prefWidth="359.0"
                        text="Create Account">
                    <font><Font size="20.0" /></font>
                </Button>

                <!-- Already have account text -->
                <Label layoutX="196.0" layoutY="385.0"
                       text="Already have an account?">
                    <font><Font size="15.0" /></font>
                </Label>

                <!-- Login link -->
                <Label fx:id="login"
                       layoutX="360.0" layoutY="385.0"
                       text="Log in" textFill="green"
                       style="-fx-cursor: hand;">
                    <font><Font size="15.0" /></font>
                </Label>

            </children>
        </AnchorPane>
    </top>

</BorderPane>
