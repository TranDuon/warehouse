<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.warehouse_desktop.controller.LoginController"
            prefHeight="566.0" prefWidth="750.0">
    <top>
        <AnchorPane prefHeight="566.0" prefWidth="750.0" BorderPane.alignment="CENTER">
            <children>

                <!-- Username -->
                <TextField fx:id="username"
                           layoutX="366.0" layoutY="234.0"
                           prefHeight="32.0" prefWidth="328.0"
                           promptText="Username">
                    <font>
                        <Font size="14.0" />
                    </font>
                </TextField>

                <!-- Password -->
                <PasswordField fx:id="userpassword"
                               layoutX="366.0" layoutY="278.0"
                               prefHeight="32.0" prefWidth="328.0"
                               promptText="Password">
                    <font>
                        <Font size="14.0" />
                    </font>
                </PasswordField>

                <!-- Logo -->
                <ImageView fitHeight="227.0" fitWidth="237.0"
                           layoutX="418.0"
                           pickOnBounds="true" preserveRatio="true">
                    <image>
                        <Image url="@../images/logo-icon.png" />
                    </image>
                </ImageView>

                <!-- Background image -->
                <ImageView fitHeight="282.0" fitWidth="503.0"
                           layoutX="-110.0" layoutY="109.0"
                           pickOnBounds="true" preserveRatio="true"
                           rotate="90.0"
                           AnchorPane.leftAnchor="-110.0">
                    <image>
                        <Image url="@../images/background.JPG" />
                    </image>
                </ImageView>

                <!-- Login button -->
                <Button fx:id="login_button"
                        layoutX="366.0" layoutY="336.0"
                        prefHeight="30.0" prefWidth="328.0"
                        text="LOG IN" textFill="#555555">
                </Button>

                <!-- Signup link (fixed - removed wrong handler) -->
                <Label fx:id="signup"
                       layoutX="515.0" layoutY="386.0"
                       text="Sign up" textFill="green"
                       style="-fx-cursor: hand;" />

                <!-- Notification message -->
                <Label fx:id="noti"
                       layoutX="366.0" layoutY="311.0"
                       text="Incorrect username or password!"
                       textFill="#fa0707"
                       visible="false" />

                <!-- Text -->
                <Label layoutX="366.0" layoutY="386.0"
                       text="Don't have an account?"
                       textFill="#555555" />

            </children>
        </AnchorPane>
    </top>

    <left>
        <AnchorPane prefHeight="200.0" prefWidth="200.0"
                    BorderPane.alignment="CENTER" />
    </left>

</BorderPane>
