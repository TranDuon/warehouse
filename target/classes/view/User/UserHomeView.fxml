<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.warehouse_desktop.controller.user.UserHomeController"
            style="-fx-background-color: white;"
            prefHeight="800" prefWidth="900">

    <center>
        <VBox alignment="TOP_CENTER" spacing="25">
            <padding>
                <Insets top="30" bottom="30" left="40" right="40"/>
            </padding>

            <Label text="Quản lý người dùng"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #1E3D59;"/>

            <Label text="Chọn chức năng"
                   style="-fx-font-size: 16px; -fx-text-fill: #4B4B4B;"/>

            <GridPane hgap="35" vgap="20">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>

                <!-- Tạo tài khoản -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: #4CAF50; -fx-background-radius: 12;"
                      GridPane.columnIndex="0">

                    <padding>
                        <Insets top="15" bottom="15" left="15" right="15"/>
                    </padding>

                    <Label text="🧑 Tạo tài khoản mới"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Label text="Thêm người dùng mới vào hệ thống."
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: white;"/>

                    <Button fx:id="btnCreate" text="Mở"
                            prefHeight="35" prefWidth="120"
                            style="-fx-background-color: white; -fx-text-fill: #4CAF50; -fx-font-weight: bold;"/>

                </VBox>

                <!-- Danh sách người dùng -->
                <VBox alignment="CENTER" spacing="15"
                      style="-fx-background-color: #2196F3; -fx-background-radius: 12;"
                      GridPane.columnIndex="1">

                    <padding>
                        <Insets top="18" bottom="18" left="18" right="18"/>
                    </padding>

                    <Label text="📋 Danh sách người dùng"
                           style="-fx-font-size: 17px; -fx-font-weight: bold; -fx-text-fill: white;"/>

                    <Label text="Xem danh sách tài khoản trong hệ thống."
                           wrapText="true"
                           style="-fx-font-size: 13px; -fx-text-fill: white;"/>

                    <Button fx:id="btnList" text="Mở"
                            prefWidth="120" prefHeight="35"
                            style="-fx-background-color: white; -fx-text-fill: #2196F3; -fx-font-weight: bold;"/>

                </VBox>

            </GridPane>

        </VBox>
    </center>

</BorderPane>
