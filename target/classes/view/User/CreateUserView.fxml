<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.warehouse_desktop.controller.user.CreateUserController"
            prefHeight="500" prefWidth="600"
            stylesheets="@/css/style.css">

    <top>
        <Label text="Tạo người dùng mới"
               style="-fx-font-size: 20px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER"/>
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets top="15" bottom="15" left="20" right="20"/>
            </padding>

            <Label text="Username:"/>
            <TextField fx:id="username"/>

            <Label text="Password:"/>
            <PasswordField fx:id="password"/>

            <Label text="Email:"/>
            <TextField fx:id="email"/>

            <Label text="Số điện thoại:"/>
            <TextField fx:id="phone"/>

            <HBox spacing="8" alignment="CENTER_LEFT">
                <Label text="Enabled:"/>
                <CheckBox fx:id="enabled"/>
            </HBox>

            <Label text="Chọn quyền:" style="-fx-font-weight: bold;"/>
            <ListView fx:id="roleList" prefHeight="150"/>

            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="btnSave" text="Lưu"/>
                <Button fx:id="btnCancel" text="Hủy"/>
            </HBox>

        </VBox>
    </center>

</BorderPane>
