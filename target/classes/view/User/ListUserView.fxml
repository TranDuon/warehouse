<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="600" prefWidth="900"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.mycompany.warehouse_desktop.controller.user.ListUserController"
            stylesheets="@/css/style.css">

    <!-- HEADER -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-padding: 15; -fx-background-color: #f4f4f4;">
            <Label text="Danh sách người dùng"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>
            <HBox HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnCreate"
                    text="Tạo tài khoản"
                    style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-padding: 6 14;"/>
        </HBox>
    </top>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="10">
            <padding>
                <Insets top="10" bottom="10" left="15" right="15"/>
            </padding>

            <!-- TABLE -->
            <TableView fx:id="table" prefHeight="450" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="60" text="ID"/>
                    <TableColumn fx:id="colUsername" prefWidth="150" text="Username"/>
                    <TableColumn fx:id="colEmail" prefWidth="200" text="Email"/>
                    <TableColumn fx:id="colPhone" prefWidth="140" text="Phone"/>
                    <TableColumn fx:id="colEnabled" prefWidth="100" text="Enabled"/>
                    <TableColumn fx:id="colRoles" prefWidth="200" text="Roles"/>
                </columns>
            </TableView>

            <!-- BUTTONS -->
            <HBox alignment="CENTER_RIGHT" spacing="12">
                <Button fx:id="btnEdit" text="Sửa"
                        style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
                <Button fx:id="btnDelete" text="Xóa"
                        style="-fx-background-color: #E53935; -fx-text-fill: white;"/>
            </HBox>
        </VBox>
    </center>

</BorderPane>
