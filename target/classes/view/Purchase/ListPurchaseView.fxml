<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="800" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.warehouse_desktop.controller.purchase.ListPurchaseController">

    <!-- TITLE -->
    <top>
        <Label prefHeight="38.0" prefWidth="175.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" text="Danh sách lượt nhập" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="10">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- BỘ LỌC NGÀY -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <children>
                    <Label text="From:" />
                    <TextField fx:id="from" prefWidth="120" promptText="dd/MM/yyyy" />

                    <Label text="To:" />
                    <TextField fx:id="to" prefWidth="120" promptText="dd/MM/yyyy" />

                    <Button fx:id="search" text="Search" />
                </children>
            </HBox>

            <!-- TABLE -->
            <TableView fx:id="table" prefHeight="360" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                    <TableColumn fx:id="colThoigian" prefWidth="180" text="Thời gian" />
                    <TableColumn fx:id="colDathanhtoan" prefWidth="140" text="Đã thanh toán" />
                    <TableColumn fx:id="colUserId" prefWidth="140" text="Nhân viên" />
                </columns>
            </TableView>

            <!-- BUTTONS -->
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <children>
                    <Button fx:id="getDetails" text="Xem chi tiết" />
                </children>
            </HBox>

        </VBox>
    </center>

</BorderPane>
