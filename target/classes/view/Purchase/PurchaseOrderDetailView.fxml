<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.mycompany.warehouse_desktop.controller.purchase.PurchaseOrderDetailController">

    <top>
        <HBox spacing="20">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Label fx:id="lblTransactionId"
                   style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Label fx:id="lblTotal"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="table">
            <columns>
                <TableColumn fx:id="colProductId" text="ID SP" prefWidth="80"/>
                <TableColumn fx:id="colProductName" text="Tên sản phẩm" prefWidth="200"/>
                <TableColumn fx:id="colQuantity" text="SL" prefWidth="80"/>
                <TableColumn fx:id="colPrice" text="Giá nhập" prefWidth="120"/>
                <TableColumn fx:id="colTotal" text="Thành tiền" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <HBox spacing="15" alignment="CENTER">
            <padding>
                <Insets top="10" right="10" bottom="10" left="10"/>
            </padding>

            <Button text="Thêm" fx:id="btnAdd"/>
            <Button text="Sửa" fx:id="btnEdit"/>
            <Button text="Xóa" fx:id="btnDelete"/>

            <Pane HBox.hgrow="ALWAYS"/>

            <Button text="Quay lại" fx:id="btnBack"/>
        </HBox>
    </bottom>

</BorderPane>
