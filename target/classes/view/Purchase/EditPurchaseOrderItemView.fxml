<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.warehouse_desktop.controller.purchase.EditPurchaseOrderItemController"
      spacing="15">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Chỉnh sửa sản phẩm" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Label text="Tên SP:"/>
        <Label fx:id="lblProductName"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Số lượng:"/>
        <TextField fx:id="txtQuantity"/>
    </HBox>

    <HBox spacing="10">
        <Label text="Giá nhập:"/>
        <TextField fx:id="txtPrice"/>
    </HBox>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Cập nhật" fx:id="btnUpdate"/>
        <Button text="Xóa" fx:id="btnDelete"/>
        <Button text="Hủy" fx:id="btnCancel"/>
    </HBox>

</VBox>
