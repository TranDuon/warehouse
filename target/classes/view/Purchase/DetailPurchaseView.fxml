<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="800" stylesheets="@/css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.warehouse_desktop.controller.purchase.DetailsPurchaseTransactionController">

    <!-- TITLE -->
    <top>
        <Label alignment="CENTER" prefHeight="34.0" prefWidth="178.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Chi Tiết Lượt Nhập" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- THÔNG TIN CHUNG -->
            <GridPane hgap="10" prefHeight="80" vgap="8">
                <columnConstraints>
                    <ColumnConstraints percentWidth="15.0" prefWidth="120" />
                    <ColumnConstraints percentWidth="35.0" prefWidth="260" />
                    <ColumnConstraints percentWidth="15.0" prefWidth="120" />
                    <ColumnConstraints percentWidth="35.0" prefWidth="260" />
                </columnConstraints>

                <children>
                    <Label text="ID lượt nhập:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="id" editable="false" prefHeight="32" prefWidth="240" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Thời gian:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
                    <TextField fx:id="timestamp" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Đã thanh toán:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                    <TextField fx:id="isPaid" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                    <Label text="ID nhân viên:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="useridEmployee" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>

                <rowConstraints>
                    <RowConstraints />
                    <RowConstraints />
                </rowConstraints>
            </GridPane>

            <Label style="-fx-font-weight: bold;" text="Danh sách vật phẩm trong lượt nhập:" />

            <!-- BẢNG CHI TIẾT -->
            <TableView fx:id="table" prefHeight="260" VBox.vgrow="ALWAYS">

                <columns>
                    <TableColumn fx:id="colProductId" prefWidth="120" text="ID vật phẩm" />
                    <TableColumn fx:id="colProductName" prefWidth="240" text="Tên vật phẩm" />
                    <TableColumn fx:id="colTransactionId" prefWidth="120" text="ID lượt nhập" />
                    <TableColumn fx:id="colQuantity" prefWidth="100" text="Số lượng" />
                    <TableColumn fx:id="colPrice" prefWidth="180" text="Giá" />
                </columns>

            </TableView>

        </VBox>
    </center>

</BorderPane>
