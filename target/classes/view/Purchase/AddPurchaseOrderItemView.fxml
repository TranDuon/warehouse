<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.mycompany.warehouse_desktop.controller.purchase.AddPurchaseOrderItemController"
      spacing="10">

    <padding>
        <Insets top="15" right="15" bottom="15" left="15"/>
    </padding>

    <HBox spacing="10">
        <Label text="Tìm kiếm:"/>
        <TextField fx:id="txtSearch" promptText="Tên sản phẩm..."/>
    </HBox>

    <TableView fx:id="tableProduct" prefHeight="200">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
            <TableColumn fx:id="colName" text="Tên sản phẩm" prefWidth="200"/>
            <TableColumn fx:id="colUnit" text="Đơn vị" prefWidth="120"/>
        </columns>
    </TableView>

    <HBox spacing="10">
        <Label text="Số lượng:"/>
        <TextField fx:id="txtQuantity"/>
        <Label text="Giá nhập:"/>
        <TextField fx:id="txtPrice"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Thêm" fx:id="btnAdd"/>
        <Button text="Hủy" fx:id="btnCancel"/>
    </HBox>

</VBox>
