<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx/8.0.171"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.mycompany.warehouse_desktop.controller.purchase.CreatePurchaseTransactionController"
      spacing="15" alignment="CENTER">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Tạo phiếu nhập"
           style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Ngày nhập:"/>
        <DatePicker fx:id="datePicker"/>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Đã thanh toán:"/>
        <CheckBox fx:id="chkIsPaid"/>
    </HBox>

    <HBox spacing="15" alignment="CENTER">
        <Button text="Tạo" fx:id="btnCreate"/>
        <Button text="Hủy" fx:id="btnCancel"/>
    </HBox>

</VBox>
