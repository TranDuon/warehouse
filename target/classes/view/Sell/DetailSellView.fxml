<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="500" prefWidth="800" stylesheets="@../css/style.css" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.mycompany.warehouse_desktop.controller.DetailSellController">

    <top>
        <Label alignment="BOTTOM_CENTER" contentDisplay="CENTER" prefHeight="41.0" prefWidth="207.0" style="-fx-font-size: 20px; -fx-font-weight: bold;" text="Chi Tiết Lượt Bán" BorderPane.alignment="CENTER" />
    </top>

    <center>
        <VBox spacing="12">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <!-- THÔNG TIN CHUNG -->
            <GridPane hgap="10" prefHeight="73.0" prefWidth="779.0" vgap="8">
                <columnConstraints>
                    <ColumnConstraints halignment="LEFT" percentWidth="15.0" prefWidth="100.0" />
                    <ColumnConstraints percentWidth="35.0" prefWidth="270.0" />
               <ColumnConstraints percentWidth="15.0" prefWidth="100.0" />
               <ColumnConstraints percentWidth="35.0" prefWidth="270.0" />
                </columnConstraints>

                <children>
                    <Label text="ID lượt bán:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
                    <TextField fx:id="id" editable="false" prefHeight="32.0" prefWidth="228.0" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                    <Label text="Thời gian:" GridPane.rowIndex="1" />
                    <TextField fx:id="thoigian" editable="false" GridPane.columnIndex="1" GridPane.rowIndex="1" />

                    <Label text="Đã thanh toán:" GridPane.columnIndex="2" />
                    <TextField fx:id="dathanhtoan" editable="false" GridPane.columnIndex="3" />

                    <Label text="ID nhân viên:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
                    <TextField fx:id="idnhanvien" editable="false" GridPane.columnIndex="3" GridPane.rowIndex="1" />
                </children>
            <rowConstraints>
               <RowConstraints />
               <RowConstraints />
               <RowConstraints maxHeight="0.0" minHeight="0.0" prefHeight="0.0" />
               <RowConstraints maxHeight="0.0" minHeight="0.0" prefHeight="0.0" />
            </rowConstraints>
            </GridPane>

                  <Label style="-fx-font-weight: bold;" text="Danh sách sản phẩm trong lượt bán:" />

            <!-- BẢNG SẢN PHẨM -->
            <TableView fx:id="table" prefHeight="265.0" prefWidth="579.0" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colIdVatPham" prefWidth="110" text="ID vật phẩm" />
                    <TableColumn fx:id="colTen" prefWidth="213.60001373291016" text="Tên vật phẩm" />
                    <TableColumn fx:id="colIdLuotBan" prefWidth="109.60003662109375" text="ID lượt bán" />
                    <TableColumn fx:id="colSoLuong" minWidth="7.199951171875" prefWidth="80.79995727539062" text="Số lượng" />
                    <TableColumn fx:id="colGia" prefWidth="200.79998779296875" text="Giá" />
                </columns>
            </TableView>
        </VBox>
    </center>

</BorderPane>
