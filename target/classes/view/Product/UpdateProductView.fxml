<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<BorderPane prefHeight="600" prefWidth="650"
            xmlns="http://javafx.com/javafx/24.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            stylesheets="@/css/style.css"
            fx:controller="com.mycompany.warehouse_desktop.controller.product.UpdateProductController">

    <!-- TOP BAR -->
    <top>
        <HBox spacing="20" style="-fx-background-color: rgba(255,255,255,0.85);">
            <padding><Insets top="12" right="20" bottom="12" left="20"/></padding>

            <ImageView fitHeight="40" preserveRatio="true">
                <image>
                    <Image url="@/images/Logo_noName.png"/>
                </image>
            </ImageView>

            <Label text="Cập nhật sản phẩm"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"/>

            <Pane HBox.hgrow="ALWAYS"/>
        </HBox>
    </top>


    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="18">
            <padding><Insets top="25" right="40" bottom="25" left="40"/></padding>

            <VBox spacing="15"
                  style="-fx-background-color: rgba(255,255,255,0.85); -fx-background-radius: 10;"
                  VBox.vgrow="ALWAYS">

                <padding><Insets top="25" right="25" bottom="25" left="25"/></padding>

                <GridPane hgap="20" vgap="12">

                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="75"/>
                    </columnConstraints>

                    <!-- ID -->
                    <Label text="ID:" GridPane.rowIndex="0"/>
                    <TextField fx:id="idField" editable="false"
                               GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <!-- Name -->
                    <Label text="Tên:" GridPane.rowIndex="1"/>
                    <TextField fx:id="nameField"
                               GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <!-- Price -->
                    <Label text="Giá:" GridPane.rowIndex="2"/>
                    <TextField fx:id="priceField"
                               GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <!-- Unit -->
                    <Label text="Đơn vị:" GridPane.rowIndex="3"/>
                    <TextField fx:id="unitField"
                               GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <!-- Description -->
                    <Label text="Mô tả:" GridPane.rowIndex="4" GridPane.valignment="TOP"/>
                    <TextArea fx:id="descriptionField" prefRowCount="4"
                              GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <!-- Quantity -->
                    <Label text="Số lượng:" GridPane.rowIndex="5"/>
                    <TextField fx:id="quantityField"
                               GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                </GridPane>


                <!-- BUTTONS -->
                <HBox alignment="CENTER_RIGHT" spacing="15">
                    <Button fx:id="updateButton" text="Cập nhật"/>
                    <Button fx:id="cancelButton" text="Hủy"/>
                </HBox>

            </VBox>
        </VBox>
    </center>

</BorderPane>
